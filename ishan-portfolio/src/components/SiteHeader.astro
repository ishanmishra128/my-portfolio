---
const { currentPath = "/" } = Astro.props;
const links = [
  { href: "/#work", label: "Work" },
  { href: "/about/", label: "About" },
  { href: "/#contact", label: "Contact" },
];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Ishan Mishra, home">ISHAN MISHRA<span>.</span></a>
  <nav class="main-nav" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} class:list={{ "nav-active": currentPath === link.href }}>{link.label}</a>
    ))}
    <a class="nav-resume" href="/resume.pdf" target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
  </nav>
</header>
