---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { projects } from "../data/projects.js";
import portrait from "../assets/ishan.png";
---
<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-meta">
      <p class="eyebrow"><span class="status-dot"></span> INFORMATION SYSTEMS × AI x ANALYTICS</p>
      <p class="mono muted">PORTFOLIO / 2026</p>
    </div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>I build systems that make <span class="serif-italic">data useful.</span></h1>
        <p class="hero-deck">I’m Ishan Mishra, a <b>Carnegie Mellon Masters in Information Systems</b> student with a concentration in AI Management. I graduated from the University of Wisconsin-Madison with majors in Information Systems and Data Science. I work with data pipelines, analytics, and machine learning, with a focus on making data easier to use and understand.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="/about/">A little about me <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Areas of focus">
        <figure class="hero-portrait">
          <Image src={portrait} alt="Portrait of Ishan Mishra" width={960} height={240} loading="eager" />
        </figure>
        <p class="eyebrow">CURRENT INTERESTS</p>
        <ul class="focus-list">
          <li><span>01</span> Data Engineering</li>
          <li><span>02</span> Data Analytics & BI</li>
          <li><span>03</span> Applied AI</li>
        </ul>
        <div class="aside-note">
          <span class="note-mark">↳</span>
          <p>I like work that makes messy data more reliable and the result easier to act on.</p>
        </div>
      </aside>
    </div>
    <div class="hero-bottom">
      <span class="mono">PITTSBURGH, PA · DATA / ANALYTICS / AI</span>
      <a href="#work" class="scroll-cue">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="work-section section-shell" id="work">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2>Projects with a <span class="serif-italic">purpose.</span></h2>
      </div>
      <p class="section-intro">Projects in data engineering, analytics, and machine learning, with notes on the tools, decisions, and results behind each one.</p>
    </div>
    <div class="project-list">
      {projects.map((project) => (
        <article class="project-row">
          <div class="project-index mono">{project.number}</div>
          <div class="project-main">
            <p class="eyebrow project-category">{project.category}</p>
            <h3><a href={`/projects/${project.slug}/`}>{project.title} <span aria-hidden="true">↗</span></a></h3>
            <p>{project.summary}</p>
            <div class="tag-list">{project.stack.map((tag) => <span>{tag}</span>)}</div>
          </div>
          <div class="project-result">
            <strong>{project.featuredMetric}</strong>
            <span>{project.metricLabel}</span>
            <a class="text-link" href={`/projects/${project.slug}/`}>Read case study <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="experience-section section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / EXPERIENCE</p>
        <h2>Systems that people <span class="serif-italic">depend on.</span></h2>
      </div>
      <p class="section-intro">At University Health Services, technical work had to fit real clinical workflows. I worked on access controls, reporting, and process improvements used by staff.</p>
    </div>
    <article class="experience-card">
      <div class="experience-date mono">2023 - 2026</div>
      <div class="experience-content">
        <h3>University Health Services</h3>
        <p class="experience-role">Informatics Analyst Intern</p>
        <p>Worked with clinical systems and reporting, using Python, SQL, and Tableau for audits and analysis. I also helped maintain templates and questionnaires, reviewed access permissions, and coordinated technical support requests.</p>
        <ul class="impact-list">
          <li><span>↗</span> Delivered 25+ SQL reports monthly and explained insights to non-technical stakeholders. </li>
          <li><span>↗</span> Reduced provider onboarding time by about 50% by standardizing user and inherited permissions.</li>
          <li><span>↗</span> Automated master data and operations audits in Python, cutting preparation time by 85% while meeting HIPAA compliance standards.</li>
        </ul>
      </div>
    </article>
    <article class="experience-card">
      <div class="experience-date mono">2025 - 2026</div>
      <div class="experience-content">
        <h3>Wisconsin School of Business</h3>
        <p class="experience-role">Data Analyst, Faculty-Sponsored Research</p>
        <p>Supported faculty research on how school digital policies and other factors relate to student learning outcomes and academic performance across all 50 U.S. states. I built the data pipeline behind the analysis in Python and SQL, ran hypothesis tests in R, and documented the whole workflow so the rest of the team could pick it up and reuse it.</p>
        <ul class="impact-list">
          <li><span>↗</span> Engineered end-to-end ETL/ELT pipelines in Python that pulled in and cleaned data from 500+ public sources.</li>
          <li><span>↗</span> Ran paired t-test hypothesis testing in R to evaluate how digital policy relates to student grades and performance.</li>
          <li><span>↗</span> Documented pipeline, transformation logic, and built reproducible scripts so other team members could take it over.</li>
        </ul>
      </div>
    </article>
  </section>

  <section class="skills-section section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / TOOLKIT</p>
        <h2>Tools for the <span class="serif-italic">whole process.</span></h2>
      </div>
      <p class="section-intro">This list includes tools I have used in projects and work, along with a few I am actively learning. Airflow is currently in progress as part of CivicPulse.</p>
    </div>
    <div class="skills-grid">
      <div class="skill-group"><span class="mono">01</span><h3>Languages & software</h3><div class="skill-tags"><span>Python</span><span>SQL</span><span>R</span><span>OOP</span><span>JavaScript</span><span>HTML</span><span>CSS</span><span>BeautifulSoup</span></div></div>
      <div class="skill-group"><span class="mono">02</span><h3>Data engineering</h3><div class="skill-tags"><span>dbt</span><span>ETL / ELT</span><span>Data modeling</span><span>Git / GitHub</span><span>Docker</span><span>GitHub Actions</span><span class="skill-learning">Apache Airflow · learning</span></div></div>
      <div class="skill-group"><span class="mono">03</span><h3>Databases & cloud</h3><div class="skill-tags"><span>BigQuery</span><span>PostgreSQL</span><span>Amazon Redshift</span><span>Snowflake</span><span>AWS S3</span><span>AWS Glue</span><span>Google Cloud</span><span>SageMaker</span><span>MySQL</span><span>MariaDB</span><span>Oracle SQL Developer</span><span>Firebase</span></div></div>
      <div class="skill-group"><span class="mono">04</span><h3>Analytics & AI</h3><div class="skill-tags"><span>Tableau</span><span>Excel</span><span>Pandas</span><span>Hypothesis testing</span><span>A/B testing</span><span>scikit-learn</span><span>PyTorch</span><span>CNNs</span><span>Model evaluation</span></div></div>
      <div class="skill-group"><span class="mono">05</span><h3>Governance & health data</h3><div class="skill-tags"><span>HIPAA compliance</span><span>EHR systems</span><span>Data governance</span><span>Metadata management</span><span>Data quality assurance</span></div></div>
      <div class="skill-group"><span class="mono">06</span><h3>Systems & process</h3><div class="skill-tags"><span>Red Hat Linux</span><span>Ubuntu</span><span>Agile</span><span>Wireshark</span><span>Puppet</span><span>Chef</span></div></div>
    </div>


  <section class="contact-section section-shell" id="contact">
    <p class="eyebrow">04 / GET IN TOUCH</p>
    <div class="contact-grid">
      <h2>Working on a data <span class="serif-italic">problem?</span></h2>
      <div class="contact-copy">
        <p>I’m looking for roles in data analytics, data engineering, and applied AI. I’m especially interested in work that combines reliable data systems with practical analysis.</p>
        <a class="button button-primary" href="mailto:ishan@imishra.me">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
