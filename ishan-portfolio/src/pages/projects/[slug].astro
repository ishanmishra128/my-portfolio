---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---
<BaseLayout title={`${project.title} - Ishan Mishra`} description={project.summary}>
  <article class="case-study section-shell">
    <a class="back-link" href="/#work">← Back to selected work</a>
    <header class="case-header">
      <p class="eyebrow">{project.number} / {project.category}</p>
      <h1>{project.title}<span class="title-period">.</span></h1>
      <p class="case-summary">{project.summary}</p>
      <div class="case-meta">
        <div><span class="mono">STATUS</span><strong>{project.status}</strong></div>
        <div><span class="mono">KEY FIGURE</span><strong>{project.featuredMetric} <small>{project.metricLabel}</small></strong></div>
      </div>
    </header>
    <div class="case-content">
      <section><p class="eyebrow">01 / THE PROBLEM</p><div><h2>Context matters.</h2><p>{project.problem}</p></div></section>
      <section><p class="eyebrow">02 / APPROACH</p><div><h2>From idea to workflow.</h2><p>{project.approach}</p></div></section>
      <section><p class="eyebrow">03 / TOOLS & METHODS</p><div><h2>The stack.</h2><div class="tag-list case-tags">{project.stack.map((tag) => <span>{tag}</span>)}</div></div></section>
      <section><p class="eyebrow">04 / EVIDENCE</p><div><h2>Show the work.</h2><p>Add a real architecture diagram, dashboard screenshot, or model evaluation output here. Explain what the evidence shows and how it was produced.</p><div class="evidence-placeholder"><span class="mono">PROJECT VISUAL</span><p>Add a real diagram, chart, screenshot, or model output here.</p></div></div></section>
      <section><p class="eyebrow">05 / REFLECTION</p><div><h2>What I learned.</h2><p>Describe one technical decision, one challenge, and one limitation or next step. Specific details make the work easier to assess.</p><p class="small-note">{project.note}</p></div></section>
    </div>
    <div class="case-actions">
      {!project.repo.includes("YOUR_") && <a class="button button-primary" href={project.repo} target="_blank" rel="noreferrer">View source on GitHub <span aria-hidden="true">↗</span></a>}
      {project.demo && <a class="text-link" href={project.demo} target="_blank" rel="noreferrer">View live project <span aria-hidden="true">↗</span></a>}
      <a class="text-link" href="/#work">More selected work <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</BaseLayout>
